# Reddit Conversions API — server-side only, never expose to client code.
# Generate in Reddit Events Manager > Conversions API > Generate Access Token.
REDDIT_CAPI_TOKEN=

# Pixel that receives the server-side Lead events.
REDDIT_PIXEL_ID=a2_jhwp4a92xlgr

# CRM relay: Vercel project goatara (local project northbound), server-only.
CRM_INTAKE_URL=https://goatara-lead-tracker.vercel.app
# Must exactly match goatara-lead-tracker's LEAD_WEBHOOK_SECRET.
# Use 32+ random characters without quotes, spaces or newlines.
CRM_INTAKE_SECRET=
# Optional: goatara-lead-tracker's Protection Bypass for Automation secret.
CRM_VERCEL_PROTECTION_BYPASS=

# Existing Google Sheets copy, when configured. Keep its current values.
GOATARA_SHEETS_URL=
GOATARA_SHEETS_SECRET=
